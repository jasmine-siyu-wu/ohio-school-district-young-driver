# 9. Simplify geometries for faster web loading
# Simplification is performed in a projected CRS.
map_data <- map_data %>%
st_transform(5070) %>%
st_simplify(dTolerance = 100,
preserveTopology = TRUE) %>%
st_transform(4326)
